# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# RESEND_API_KEY: Clave de API de Resend (https://resend.com) para notificación automática de registros
RESEND_API_KEY="re_123456789"

# ADMIN_NOTIFICATION_EMAIL: Correo donde el administrador recibe los datos privados de los comercios registrados
ADMIN_NOTIFICATION_EMAIL="josueco2023@gmail.com"

# CLOUDFLARE_D1: Variables opcionales para persistencia en base de datos Cloudflare D1 (Etapa 1)
# CLOUDFLARE_ACCOUNT_ID="tu_account_id_de_cloudflare"
# CLOUDFLARE_D1_DATABASE_ID="tu_database_uuid_de_d1"
# CLOUDFLARE_API_TOKEN="tu_token_con_permisos_d1_edit"

# ============================================================================
# FIREBASE AUTH & SEGURIDAD ADMINISTRATIVA DEL SERVIDOR (ETAPA 2)
# ============================================================================

# FIREBASE_PROJECT_ID: Identificador del proyecto Firebase donde reside la autenticación.
# Por defecto se utiliza 'dapp-f5e40' para coincidir con la configuración del cliente en public/app.js.
FIREBASE_PROJECT_ID="dapp-f5e40"

# ADMIN_AUTHORIZED_EMAILS: Lista de direcciones de correo electrónico autorizadas
# con privilegios de administrador en el servidor backend (separadas por coma).
# Solo usuarios con correo verificado (email_verified: true) coincidente tendrán acceso a rutas protegidas.
ADMIN_AUTHORIZED_EMAILS="josueco2023@gmail.com,josueco@gmail.com"

# FIREBASE_SERVICE_ACCOUNT_KEY: Credencial de cuenta de servicio de Firebase (opcional).
# Modos de inicialización en server.ts:
# 1. Modo Verificación Pública (por defecto si esta variable está vacía):
#    Firebase Admin valida la firma criptográfica de los ID tokens emitidos por Google utilizando
#    los certificados x509 públicos oficiales de Google y comprobando aud='dapp-f5e40'.
#    No requiere subir ninguna clave privada.
# 2. Modo Credencial Completa (si se proporciona esta variable):
#    Permite validar revocación de tokens (checkRevoked: true), administrar Custom Claims
#    y acceder a APIs privilegiadas de Firebase desde el servidor.
#    Formatos soportados:
#    - Ruta absoluta o relativa al archivo JSON: "./service-account-key.json"
#    - Contenido JSON minificado en una sola línea: '{"type":"service_account",...}'
#    - Cadena codificada en Base64 del JSON de credenciales
# FIREBASE_SERVICE_ACCOUNT_KEY=""

